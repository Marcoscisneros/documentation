  "keyFeatures": [
    "REST API for controlling pizza factory machinery",
    "Recipe management — create, update, and delete pizza recipes",
    "Production run orchestration — start, monitor, and cancel production jobs",
    "Real-time machine status monitoring",
    "Ingredient inventory tracking",
    "API key authentication",
    "Webhook notifications for production events"
  ],
  "publicApiSurface": [
    "GET /machines — list all machines",
    "GET /machines/{id} — get machine details",
    "POST /machines/{id}/start — start a machine",
    "POST /machines/{id}/stop — stop a machine",
    "GET /recipes — list recipes",
    "POST /recipes — create a recipe",
    "PUT /recipes/{id} — update a recipe",
    "DELETE /recipes/{id} — delete a recipe",
    "POST /production/runs — start a production run",
    "GET /production/runs/{id} — get production run status",
    "GET /production/runs — list production runs",
    "POST /production/runs/{id}/cancel — cancel a production run",
    "GET /ingredients — list ingredients",
    "GET /ingredients/inventory — get inventory levels"
  ]
